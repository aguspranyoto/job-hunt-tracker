# Database (Supabase PostgreSQL)
# When running in Docker on the same server as Supabase:
#   - Use the Supabase DB container's service name (e.g., supabase-db) as DB_HOST
#   - Or use the server's LAN IP
#   - DB_PORT should be the container's internal port (5432), NOT the host-mapped port
DB_HOST=supabase-db
DB_USER=postgres
DB_PASSWORD=
DB_NAME=postgres
DB_PORT=5432

# Registration restriction — only this email can create an account
MY_EMAIL=

# Better Auth
BETTER_AUTH_SECRET=change-me-to-a-random-secret
BETTER_AUTH_URL=http://localhost:3003
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3003
